{"trip":{"date":"2026-10-07","line":{"line_cd":11632,"name":"JR加古川線","company":"JR西日本","km":48.6},"persona":{"name":"みな","emoji":"🐦","traits":"海と空と光が好きな旅好きの小鳥"},"weather":"晴れ","stations":[{"name":"加古川","lat":34.767666,"lon":134.839447},{"name":"日岡","lat":34.778643,"lon":134.857153},{"name":"神野","lat":34.790922,"lon":134.878854},{"name":"厄神","lat":34.794623,"lon":134.90682},{"name":"市場","lat":34.819352,"lon":134.932494},{"name":"小野町","lat":34.833601,"lon":134.918466},{"name":"粟生","lat":34.856859,"lon":134.909509},{"name":"河合西","lat":34.879221,"lon":134.919519},{"name":"青野ケ原","lat":34.897297,"lon":134.927933},{"name":"社町","lat":34.920336,"lon":134.934507},{"name":"滝野","lat":34.941034,"lon":134.954919},{"name":"滝","lat":34.948812,"lon":134.962374},{"name":"西脇市","lat":34.971702,"lon":134.968795},{"name":"新西脇","lat":34.977907,"lon":134.977563},{"name":"比延","lat":34.988773,"lon":134.995733},{"name":"日本へそ公園","lat":35.002069,"lon":134.997633},{"name":"黒田庄","lat":35.022689,"lon":134.992522},{"name":"本黒田","lat":35.052941,"lon":134.99591},{"name":"船町口","lat":35.06291,"lon":135.009342},{"name":"久下村","lat":35.075812,"lon":135.030557},{"name":"谷川","lat":35.082724,"lon":135.049666}],"track":[[34.767858,134.839541],[34.766748,134.840712],[34.766352,134.841419],[34.766173,134.842066],[34.766082,134.84304],[34.766064,134.843733],[34.766111,134.844418],[34.766372,134.845392],[34.766761,134.846206],[34.767456,134.847046],[34.769074,134.848454],[34.780206,134.858709],[34.780962,134.859597],[34.781689,134.860573],[34.785125,134.865985],[34.785616,134.866557],[34.787165,134.86776],[34.787889,134.868478],[34.788328,134.869007],[34.788913,134.869862],[34.789309,134.87066],[34.789673,134.871599],[34.789925,134.872529],[34.790054,134.873229],[34.791228,134.880537],[34.791372,134.882751],[34.791481,134.883454],[34.792114,134.886399],[34.792121,134.887275],[34.79201,134.887904],[34.791264,134.889715],[34.791131,134.890294],[34.791059,134.890999],[34.791122,134.892022],[34.792347,134.899705],[34