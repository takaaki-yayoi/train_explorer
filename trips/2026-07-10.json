{"trip":{"date":"2026-07-10","line":{"line_cd":11513,"name":"JR名松線","company":"JR東海","km":43.5},"persona":{"name":"タカ","emoji":"🎒","traits":"のんびり屋、食べ物と古い街並みに弱い"},"weather":"晴れ","stations":[{"name":"松阪","lat":34.577053,"lon":136.535801},{"name":"上ノ庄","lat":34.597996,"lon":136.499273},{"name":"権現前","lat":34.617691,"lon":136.482202},{"name":"伊勢八太","lat":34.647523,"lon":136.446916},{"name":"一志","lat":34.654894,"lon":136.436067},{"name":"井関","lat":34.642493,"lon":136.412653},{"name":"伊勢大井","lat":34.650013,"lon":136.385179},{"name":"伊勢川口","lat":34.64767,"lon":136.356849},{"name":"関ノ宮","lat":34.637693,"lon":136.339721},{"name":"家城","lat":34.625791,"lon":136.319246},{"name":"伊勢竹原","lat":34.599785,"lon":136.309081},{"name":"伊勢鎌倉","lat":34.574023,"lon":136.278349},{"name":"伊勢八知","lat":34.555355,"lon":136.263952},{"name":"比津","lat":34.531967,"lon":136.270716},{"name":"伊勢奥津","lat":34.512155,"lon":136.260031}],"track":[[34.577053,136.535801],[34.580118,136.532193],[34.583872,136.527404],[34.584502,136.526691],[34.585487,136.525868],[34.58766,136.52449],[34.588182,136.524098],[34.588841,136.523417],[34.589407,136.522642],[34.589836,136.521815],[34.593035,136.514261],[34.593505,136.512732],[34.595709,136.503972],[34.5961,136.502823],[34.596421,136.502097],[34.598385,136.498569],[34.599307,136.497121],[34.604796,136.4898],[34.606111,136.488216],[34.60674,136.487711],[34.60762,136.487119],[34.62225,136.479965],[34.622761,136.479633],[34.623117,136.479319],[34.623828,136.478486],[34.632801,136.467617],[34.633453,136.466999],[34.634055,136.46654],[34.634577,136.466239],[34.636118,136.465583],[34.636618,136.465315],[34.637124,136.464835],[34.637376,136.464489],[34.637625,136.464023],[34.642042,136.454022],[34.642528,136.453103],[34.643177,136.452052],[34.643585,136.451486],[34.653635,136.439674],[34.654036,136.439095],[34.654403,136.438328],[34.654637,136.43761],[34.654795,136.436913],[34.654893,136.436106],[34.654906,136.435243],[34.654801,136.434245],[34.654659,136.433607],[34.654296