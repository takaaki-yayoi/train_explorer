{"trip":{"date":"2026-09-18","line":{"line_cd":11631,"name":"JR赤穂線","company":"JR西日本","km":64.6},"persona":{"name":"ゲン","emoji":"🦊","traits":"歴史と地理が好きな理屈っぽい狐"},"weather":"晴れ","stations":[{"name":"相生","lat":34.818052,"lon":134.47341},{"name":"西相生","lat":34.801303,"lon":134.450563},{"name":"坂越","lat":34.768679,"lon":134.417244},{"name":"播州赤穂","lat":34.756601,"lon":134.392976},{"name":"天和","lat":34.749097,"lon":134.351418},{"name":"備前福河","lat":34.746681,"lon":134.331664},{"name":"寒河","lat":34.746122,"lon":134.29778},{"name":"日生","lat":34.735148,"lon":134.276485},{"name":"伊里","lat":34.741424,"lon":134.224525},{"name":"備前片上","lat":34.748295,"lon":134.197006},{"name":"西片上","lat":34.745193,"lon":134.184177},{"name":"伊部","lat":34.738798,"lon":134.160554},{"name":"香登","lat":34.727737,"lon":134.119542},{"name":"長船","lat":34.699909,"lon":134.098828},{"name":"邑久","lat":34.668526,"lon":134.091027},{"name":"大富","lat":34.661429,"lon":134.070762},{"name":"西大寺","lat":34.661878,"lon":134.037037},{"name":"大多羅","lat":34.665661,"lon":134.006354},{"name":"東岡山","lat":34.685633,"lon":133.988103},{"name":"高島","lat":34.683074,"lon":133.95774},{"name":"西川原","lat":34.678,"lon":133.936555},{"name":"岡山","lat":34.666572,"lon":133.918552}],"track":[[34.81805,134.473499],[34.818118,134.47153],[34.8181,134.470713],[34.818065,134.471234],[34.818046,134.469796],[34.817825,134.468468],[34.817362,134.467071],[34.816933,134.466235],[34.81644,134.46551],[34.815908,134.464858],[34.815339,134.464338],[34.81457,134.463785],[34.8083,134.460455],[34.807746,134.460092],[34.80702,134.459494],[34.806397,134.458841],[34.805743,134.457971],[34.801978,134.45148],[34.80138,134.450642],[34.801005,134.450206],[34.800173,134.44945],[34.799567,134.449025],[34.798511,134.448481],[34.796407,134.447845],[34.794791,134.447227],[34.794209,134.446942],[34.793244,134.446297],[34.792063,134.445103],[34.783649,134.43537],[34.767767,134.416002],[34.75978,134.406339],[34.758898,134.405104],[34.758302,134.404021],[34.757955,134.4033