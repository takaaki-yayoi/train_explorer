{"trip":{"date":"2026-11-09","line":{"line_cd":11635,"name":"JR播但線","company":"JR西日本","km":66.1},"persona":{"name":"ぽこ","emoji":"🐰","traits":"食いしん坊でのんびり屋。名物と甘味に目がない"},"weather":"晴れ","stations":[{"name":"姫路","lat":34.827659,"lon":134.690769},{"name":"京口","lat":34.834672,"lon":134.70535},{"name":"野里","lat":34.856142,"lon":134.711251},{"name":"砥堀","lat":34.866427,"lon":134.724833},{"name":"仁豊野","lat":34.885144,"lon":134.728315},{"name":"香呂","lat":34.911389,"lon":134.735895},{"name":"溝口","lat":34.927859,"lon":134.742347},{"name":"福崎","lat":34.960637,"lon":134.750618},{"name":"甘地","lat":34.98814,"lon":134.758525},{"name":"鶴居","lat":35.023742,"lon":134.754716},{"name":"新野","lat":35.050278,"lon":134.752482},{"name":"寺前","lat":35.065462,"lon":134.743255},{"name":"長谷","lat":35.117029,"lon":134.748103},{"name":"生野","lat":35.163227,"lon":134.789259},{"name":"新井","lat":35.236471,"lon":134.79508},{"name":"青倉","lat":35.26719,"lon":134.811789},{"name":"竹田","lat":35.298459,"lon":134.835422},{"name":"和田山","lat":35.34141,"lon":134.85137}],"track":[[34.827659,134.690769],[34.827165,134.690419],[34.826912,134.692368],[34.826508,134.694067],[34.826328,134.695182],[34.826259,134.696218],[34.826376,134.697466],[34.826585,134.698185],[34.826794,134.69871],[34.82727,134.699512],[34.828515,134.701036],[34.829818,134.70253],[34.83018,134.702873],[34.830934,134.703449],[34.832419,134.704372],[34.833302,134.704781],[34.835079,134.70547],[34.835529,134.705596],[34.836552,134.705719],[34.84778,134.705756],[34.84846,134.705874],[34.849204,134.706202],[34.85398,134.708748],[34.854363,134.709018],[34.85473,134.709369],[34.855554,134.710363],[34.859359,134.717011],[34.860371,134.718863],[34.861095,134.7199],[34.869858,134.727917],[34.870383,134.728323],[34.871419,134.728876],[34.872461,134.729248],[34.873133,134.729375],[34.874468,134.729399],[34.883388,134.728185],[34.884472,134.728151],[34.885624,134.728332],[34.886124,134.728475],[34.887457,134.729084],[34.88998,134.730584],[34.890797,134.730953],